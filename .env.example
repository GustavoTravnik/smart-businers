# =============================================================
# SmartBusiners AI Engine - Environment Configuration
# =============================================================

# Google Gemini / AI Studio API Key (Obtain from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Default Gemini Model (Options: gemini-2.5-flash, gemini-2.5-pro, gemini-2.0-flash)
SMARTBUSINERS_DEFAULT_MODEL=gemini-2.5-flash

# Default Temperature (0.0 to 1.0)
SMARTBUSINERS_TEMPERATURE=0.7

# Default Workspace Directory (Leave empty for current directory)
SMARTBUSINERS_WORKSPACE=

# Web GUI Server Configuration
SMARTBUSINERS_HOST=127.0.0.1
SMARTBUSINERS_PORT=8080
